--- !u!114 &413078283430909878
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2329310413810383875}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fef861c106984c4189bafa10c7f487e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  imgBearHolder: {fileID: 6506967921645409560}
  speechText: {fileID: 3951494218234034636}
  imgBearyNormal: {fileID: 21300000, guid: 2bf95750dd301c242bf52e596ea58e18, type: 3}
  imgBearySmirky: {fileID: 21300000, guid: 9de23079ed3b3f84189c86d0e6154021, type: 3}
  messageLibrary:
  - lookUpName: Story_1
    messageType: 0
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: "Don\u2019t be scared, Maho. I\u2019m Bear, your best friend,
      remember? "
  - lookUpName: Story_2
    messageType: 0
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: 'With magic, I will help you get home safely. Follow me! '
  - lookUpName: Controls_Jump
    messageType: 1
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: Try jumping by pressing [W] or [Up Arrow]
  - lookUpName: Controls_Dash
    messageType: 1
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: 'Try dashing forward by pressing [D] or [Right Arrow] '
  - lookUpName: Controls_Move
    messageType: 1
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: 'Try retract backward by pressing [A] or [Left Arrow] '
  - lookUpName: Story_3
    messageType: 0
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: "Oh, don\u2019t worry, it\u2019s just a slow Jelly. Try to dodge
      it using your movement. "
  - lookUpName: Controls_Pokie
    messageType: 1
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: Collect your Pokie and then Shoot! [Space Bar]
  - lookUpName: Story_4
    messageType: 0
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: 'Shoot Jelly with Pokie, it will scare her away!  '
  - lookUpName: Story_5
    messageType: 0
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: "Good job Maho, you\u2019re doing great !  "
  - lookUpName: Story_6
    messageType: 0
    timesPlayed: 0
    useSneakyBearIcon: 0
    messageContent: Oh no! The monsters are taking me Maho! Please help me!
  - lookUpName: Story_7
    messageType: 0
    timesPlayed: 0
    useSneakyBearIcon: 1
    messageContent: "Nice try Maho, but it\u2019s over, I have the high ground!"
  - lookUpName: Story_8
    messageType: 0
    timesPlayed: 0
    useSneakyBearIcon: 1
    messageContent: "These foolish animals, they just love you and think that\u2019s
      enough. But not for me, Maho, I need you, ever since I was given to you on
      your 3rd birthday.  "
  - lookUpName: Story_9
    messageType: 0
    timesPlayed: 0
    useSneakyBearIcon: 1
    messageContent: Love me forever!
