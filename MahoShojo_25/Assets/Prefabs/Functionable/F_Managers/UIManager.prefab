--- !u!114 &413078283430909878
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2329310413810383875}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fef861c106984c4189bafa10c7f487e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  imgBearHolder: {fileID: 6506967921645409560}
  speechText: {fileID: 3951494218234034636}
  imgBearyNormal: {fileID: 709943758, guid: 2179568ae6f951b40b656e2611e1d6af, type: 3}
  imgBearySmirky: {fileID: 491877713, guid: 2179568ae6f951b40b656e2611e1d6af, type: 3}
  textToSayInOrder:
  - "Don\u2019t be scared, Miho. I\u2019m Bear, your best friend, remember? "
  - 'With magic, I will help you get home safely. Follow me! '
  - Try jumping by pressing [W] or [Up Arrow]
  - 'Try dashing forward by pressing [D] or [Right Arrow] '
  - 'Try retract backward by pressing [A] or [Left Arrow] '
  - "Oh, don\u2019t worry, it\u2019s just a slow Jelly. Try to dodge it using your
    movement.   "
  - "It\u2019s Pokie, your favorite! You can collect it by running directly into
    it. Now you can shoot Pokie by pressing [Space Bar]"
  - 'Try to shoot Jelly with Pokie, it will scare her away!  '
  - "Good job Maho, you\u2019re doing great !  "
  - 'Oh no! The monsters are taking me Maho! Please help me!  '
  - "Nice try Maho, but it\u2019s over, I have the high ground! "
  - "These foolish animals, they just love you and think that\u2019s enough. But
    not for me, Maho, I need you, ever since I was given to you on your 3rd birthday.  "
  - 'Love me forever!    '
  capturedImages:
  - {fileID: 3881527486609935295}
  - {fileID: 9154612546162082054}
  - {fileID: 3083255948046699271}
  - {fileID: 1799410058147867548}
  - {fileID: 3703114836995928429}
  - {fileID: 7097473972154824185}
  gameOverScreenObj: {fileID: 4076102062023590322}
  gameWinScreenObj: {fileID: 8962700005799110752}
